vertex_program PlagC/SkyVS_GL glsl
{
    source PlagCSky_vs.glsl
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
    }
}
vertex_program PlagC/SkyVS_VK glslvk
{
    preprocessor_defines PLAGC_VULKAN_SHADER=1
    source PlagCSky_vs.glsl
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
    }
}
vertex_program PlagC/SkyVS unified
{
    delegate PlagC/SkyVS_VK
    delegate PlagC/SkyVS_GL
}
fragment_program PlagC/SkyPS_GL glsl
{
    source PlagCSky_ps.glsl
    default_params
    {
        param_named skyCubemap int 0
    }
}
fragment_program PlagC/SkyPS_VK glslvk
{
    preprocessor_defines PLAGC_VULKAN_SHADER=1
    source PlagCSky_ps.glsl
}
fragment_program PlagC/SkyPS unified
{
    delegate PlagC/SkyPS_VK
    delegate PlagC/SkyPS_GL
}
material PlagC/Sky
{
    technique
    {
        pass
        {
            depth_check on
            depth_write off
            cull_hardware none
            vertex_program_ref PlagC/SkyVS {}
            fragment_program_ref PlagC/SkyPS {}
            texture_unit
            {
                filtering trilinear
                tex_address_mode clamp
            }
        }
    }
}
