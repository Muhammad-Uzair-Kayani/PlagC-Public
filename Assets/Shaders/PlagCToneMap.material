vertex_program PlagC/ToneVS glsl
{
    source PlagCToneMap_vs.glsl
    default_params { param_named_auto worldViewProj worldviewproj_matrix }
}
fragment_program PlagC/TonePS glsl
{
    source PlagCToneMap_ps.glsl
    default_params
    {
        param_named sceneTexture int 0
        param_named exposure float 1
        param_named bloomTexture int 1
        param_named bloomStrength float .18
        param_named depthTexture int 2
        param_named cameraNear float .1
        param_named cameraFar float 1000
        param_named fogDensity float 0
        param_named fogColour float3 .38 .42 .40
    }
}
material PlagC/ToneMap
{
    technique
    {
        pass
        {
            depth_check off
            depth_write off
            cull_hardware none
            vertex_program_ref PlagC/ToneVS {}
            fragment_program_ref PlagC/TonePS {}
            texture_unit { filtering bilinear }
            texture_unit { filtering bilinear }
            texture_unit { filtering none }
        }
    }
}

fragment_program PlagC/BloomExtractPS glsl
{
    source PlagCBloom_ps.glsl
    default_params
    {
        param_named sourceTexture int 0
        param_named lowTexture int 1
        param_named mode int 0
        param_named threshold float 1.1
    }
}
material PlagC/BloomExtract
{
    technique
    {
        pass
        {
            depth_check off
            depth_write off
            cull_hardware none
            vertex_program_ref PlagC/ToneVS {}
            fragment_program_ref PlagC/BloomExtractPS {}
            texture_unit { filtering bilinear }
            texture_unit { filtering bilinear }
        }
    }
}

